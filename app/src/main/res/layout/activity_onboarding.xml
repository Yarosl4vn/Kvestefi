<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hello"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/logoBubble"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_high"
                    android:contentDescription="Значок"
                    android:padding="14dp"
                    android:src="@drawable/ic_card_rocket"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Квестефи"
                        android:textColor="?attr/colorOnPrimary" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Учимся к ОГЭ, ЕГЭ и ВПР играя"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/stepHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <!-- ШАГ 1: приветствие -->
                <LinearLayout
                    android:id="@+id/stepWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Привет! Я — Квестефи" />

                    <TextView
                        style="@style/TextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Собираю квесты из настоящих заданий ОГЭ, ЕГЭ и ВПР. Решаешь — получаешь очки, держишь серию дней и видишь прогноз своей оценки. Настроим всё за минуту: имя, аватар, предметы и слабые темы."
                        android:textColor="@color/on_bg_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/feature1"
                            layout="@layout/part_feature" />

                        <include
                            android:id="@+id/feature2"
                            layout="@layout/part_feature" />

                        <include
                            android:id="@+id/feature3"
                            layout="@layout/part_feature" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_stat"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
        android:padding="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_card_person" 
        app:tint="?attr/colorOnPrimaryContainer"
        
        android:contentDescription="Значок"
        />

                        <TextView
                            style="@style/TextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Задачи и разбор ошибок готовит ИИ-наставник. Офлайн-ядро уже работает — приложение играется без интернета." />
                    </LinearLayout>
                </LinearLayout>

                <!-- ШАГ 2: имя и аватар -->
                <LinearLayout
                    android:id="@+id/stepName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Как тебя звать?" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Имя будет указано в профиле и в статистике." />

                    <EditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_input"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:maxLength="18"
                        android:maxLines="1"
                        android:textColor="@color/on_bg"
                        android:textSize="16sp" 
        android:gravity="center_vertical"
        android:minHeight="52dp"
        />

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="ПОЛ" />

                    <LinearLayout
                        android:id="@+id/genderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="ВЫБЕРИ АВАТАР" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Можно оставить эмодзи или поставить свою картинку из галереи — в настройках."
                        android:textSize="12sp" />

                    <GridLayout
                        android:id="@+id/avatarGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:columnCount="4" />
                </LinearLayout>

                <!-- ШАГ 3: предметы -->
                <LinearLayout
                    android:id="@+id/stepSubjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Что готовим?" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Можно выбрать несколько предметов." />

                    <LinearLayout
                        android:id="@+id/subjectBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="СЛАБЫЕ ТЕМЫ — ПОДТЯНЕМ" />
                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Темы идут по предметам. Отметь то, что хочешь подтянуть, или нажми «все темы» у предмета."
                            android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/topicBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- ШАГ 4: цель и тема оформления -->
                <LinearLayout
                    android:id="@+id/stepGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Твой план" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Сколько квестов проходить за день?" />

                    <LinearLayout
                        android:id="@+id/goalRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_stat"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Тёмная тема"
                            android:textColor="@color/on_bg"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/themeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_stat"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Подсказки и разборы"
                            android:textColor="@color/on_bg"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/hintsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/summary"
                        style="@style/TextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_stat"
                        android:padding="16dp"
                        android:textColor="@color/on_bg_variant" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Назад" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Дальше" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />
            </LinearLayout>

            <TextView
                android:id="@+id/skip"
                style="@style/TextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="Заполню позже" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
