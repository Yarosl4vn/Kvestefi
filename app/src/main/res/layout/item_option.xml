<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_option_normal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="66dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/optionBadge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_surface"
        android:gravity="center"
        android:text="А"
        android:textColor="@color/on_bg"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/optionText"
        style="@style/TextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Вариант ответа" />

    <TextView
        android:gravity="center"
        android:id="@+id/optionMark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:textSize="20sp"
        android:visibility="gone" />
</LinearLayout>
