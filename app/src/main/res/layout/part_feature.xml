<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stat"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:padding="12dp"
        android:id="@+id/featureIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_surface"
        android:src="@drawable/ic_badge_bolt" 
        app:tint="?attr/colorPrimary"
        
        android:contentDescription="Значок"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/featureTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Очки за скорость"
            android:textColor="@color/on_bg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/featureText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ответил за 10 секунд — плюс 5 бонусных очков."
            android:textColor="@color/on_bg_variant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
