<?xml version="1.0" encoding="utf-8"?>
<!-- Приветствие при каждом входе в приложение -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:id="@+id/helloIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="Квестефи"
        android:padding="14dp"
        android:src="@drawable/ic_card_rocket"
        app:tint="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/helloTitle"
        style="@style/TextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="С возвращением!" />

    <TextView
        android:id="@+id/helloText"
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Готов продолжить?"
        android:textColor="@color/on_bg_variant" />

    <TextView
        android:id="@+id/helloStreak"
        style="@style/TextMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_stat"
        android:padding="14dp"
        android:text="Серия: 0 дней" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/helloButton"
        style="@style/BtnPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Погнали" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />
</LinearLayout>
