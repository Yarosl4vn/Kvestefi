<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/histRoot"
    android:layout_width="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stat"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:padding="12dp"
        android:id="@+id/histIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_surface"
        android:src="@drawable/ic_subj_math" 
        app:tint="?attr/colorPrimary"
        
        android:contentDescription="Значок"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/histTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Математика"
            android:textColor="@color/on_bg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/histMeta"
            style="@style/TextMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="4 из 5 · 1 мин 10 сек" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/histScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+45"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/histGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:layout_marginTop="4dp"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="оценка 4"
            android:textColor="@color/on_bg"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/histArrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Подробнее о попытке"
            android:src="@drawable/ic_card_next"
            app:tint="@color/on_bg_variant" />
    </LinearLayout>
</LinearLayout>
