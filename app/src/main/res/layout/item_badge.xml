<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/badgeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_badge_locked"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/badgeIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="Достижение"
        android:padding="11dp"
        android:src="@drawable/ic_badge_check"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/badgeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Первый шаг"
        android:textColor="@color/on_bg"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/badgeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Пройти первый квест"
        android:textColor="@color/on_bg_variant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/badgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="закрыт"
        android:textColor="@color/on_bg_variant"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
