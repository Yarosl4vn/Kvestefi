<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/resultSubject"
                style="@style/TextSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="МАТЕМАТИКА · КВЕСТ ПРОЙДЕН" />

            <FrameLayout
                android:id="@+id/gradeCircle"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gradeNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="4"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="62sp" />

                    <TextView
                        android:id="@+id/gradeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Хорошо"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="ПРОГНОЗ ОЦЕНКИ ОГЭ"
                android:textColor="@color/on_bg_variant"
                android:textSize="12sp"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/scoreBig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="0 очков"
                android:textColor="@color/accent"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/gradeComment"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/on_bg_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/statCorrect"
                        style="@style/TextNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/5" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="верно" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/statTime"
                        style="@style/TextNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0с" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="время" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/statStreak"
                        style="@style/TextNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />

                    <TextView
                        style="@style/TextMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="серия" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/CardKvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ИЗ ЧЕГО СЛОЖИЛИСЬ ОЧКИ" />

                    <LinearLayout
                        android:id="@+id/bonusBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:id="@+id/newBadgesBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/topicsCard"
                style="@style/CardKvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ЧТО ПОДТЯНУТЬ" />

                    <LinearLayout
                        android:id="@+id/topicsBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="ПОДЕЛИТЬСЯ РЕЗУЛЬТАТОМ" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVk"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ВКонтакте" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
                android:maxLines="1"
        android:textSize="13sp"
        />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTg"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Telegram" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
                android:maxLines="1"
        android:textSize="13sp"
        />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoreShare"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Ещё" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
                android:maxLines="1"
        android:textSize="13sp"
        />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ещё квест" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="В главное меню" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />
        </LinearLayout>
    </ScrollView>

    <ru.readysquad.kvest.widget.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
