<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topicCard"
    style="@style/CardKvest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
        android:padding="12dp"
                android:id="@+id/topicIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_surface"
                android:src="@drawable/ic_subj_math" 
        app:tint="?attr/colorPrimary"
        
        android:contentDescription="Значок"
        />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/topicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Алгебра"
                    android:textColor="@color/on_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topicMeta"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Математика · ОГЭ" />
            </LinearLayout>

            <TextView
        android:gravity="center"
                android:id="@+id/topicChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textColor="@color/on_bg_variant"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/topicTeaser"
            style="@style/TextMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="" />

        <LinearLayout
            android:id="@+id/topicBodyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline" />

            <TextView
                android:id="@+id/topicBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="@color/on_bg"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLearned"
                style="@style/BtnTonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Отметить как повторённое" 
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="52dp"
        />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
