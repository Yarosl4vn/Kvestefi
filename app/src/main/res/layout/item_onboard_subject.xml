<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardSubjectRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_subject_choice"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:padding="12dp"
        android:id="@+id/onboardSubjectIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_surface"
        android:src="@drawable/ic_subj_math" 
        app:tint="?attr/colorPrimary"
        
        android:contentDescription="Значок"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/onboardSubjectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Математика"
            android:textColor="@color/on_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboardSubjectTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Алгебра, Геометрия"
            android:textColor="@color/on_bg_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/onboardSubjectCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_circle_primary"
        android:gravity="center"
        android:text=""
        android:textColor="?attr/colorOnPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="invisible" />
</LinearLayout>
